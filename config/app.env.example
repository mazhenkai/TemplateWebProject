# 复制为 app.env 后填写真实值；app.env 不入库。
# 新增配置项时同步修改本文件。

# ---------- 环境 ----------
# dev | prd
APP_ENV=dev

# ---------- 端口与开发启动命令（opt/linux/dev_daily.sh 用）----------
FRONTEND_PORT=
BACKEND_PORT=
# 分别在 frontend/、backend/ 目录下执行；不需要的一端留空。含空格的值必须加引号
FRONTEND_DEV_CMD="npm run dev -- -p $FRONTEND_PORT -H 127.0.0.1"
BACKEND_DEV_CMD=""
# Python 项目使用的 conda 环境名与安装位置（env.sh 的 activate_py 用）
PY_ENV=
CONDA_BASE=~/miniconda3

# ---------- 数据库 ----------
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PASSWORD=
# dev | prd，与 APP_ENV 对应
DB_SCHEMA=dev

# ---------- 前端（带前缀的变量会进入浏览器包，只放公开信息）----------
NEXT_PUBLIC_API_BASE=

# ---------- 第三方服务 ----------
# XXX_API_KEY=

# ---------- 运维脚本（opt/linux/*.sh 用）----------
# 测试命令，push.sh / daily_pipeline.sh 会执行
TEST_CMD=""
# 推送的远程与分支；PUSH_KEY_<远程名> 指定该远程用的私钥（不设则走默认 ssh 配置）
PUSH_REMOTES="github gitee"
PUSH_BRANCH=main
# PUSH_KEY_github=~/.ssh/id_github
# check.sh 额外扫描的敏感词（正则，| 分隔），如本机路径、公网 IP、内部域名
CHECK_EXTRA_PATTERNS=""

# ---------- 表结构同步（opt/linux/sync_tables.sh 用）----------
# 白名单：要从 dev 同步到 prd 的正式表，空格分隔。新增正式表时必须同步修改
TB_WHITELIST=""
DEV_SCHEMA=dev
PRD_SCHEMA=prd
# 留空则用 psql + 上面的 DB_*；数据库在容器里时如 "docker exec -i <容器名> psql -U <用户> -d <库名>"
PSQL_CMD=""

# ---------- 日志 ----------
# dev_daily 归档日志保留天数
KEEP_DAYS=14
